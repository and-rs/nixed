{
	"manifest_version": 3,
	"name": "Tab Search",
	"key": "",
	"short_name": "Tab Search",
	"version": "2.0.2",
	"description": "Search open tabs and bookmarks.",
	"author": "Brometheus",
	"minimum_chrome_version": "121",
	"permissions": ["tabs", "bookmarks", "favicon"],
	"icons": {
		"16": "img/icon-16.png",
		"48": "img/icon-48.png",
		"128": "img/icon-128.png"
	},
	"action": {
		"default_title": "Tab Search",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "img/icon-16.png",
			"48": "img/icon-48.png"
		}
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+O",
				"mac": "Command+O"
			}
		}
	}
}
