{
  "manifest_version": 3,
  "name": "Browsing Boundaries",
  "version": "1.0.0",
  "description": "Site boundaries, redirects, and strict Reddit NSFW filtering.",
  "permissions": ["declarativeNetRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "declarative_net_request": {
    "rule_resources": [{"id": "boundaries", "enabled": true, "path": "rules.json"}]
  },
  "content_scripts": [{
    "matches": ["*://reddit.com/*", "*://www.reddit.com/*", "*://new.reddit.com/*", "*://sh.reddit.com/*"],
    "run_at": "document_start",
    "js": ["config.js", "logic.js", "content.js"],
    "css": ["filter.css"]
  }],
  "web_accessible_resources": [{
    "resources": ["blocked.html"],
    "matches": ["*://*.reddit.com/*", "*://reddit.com/*"]
  }]
}
