set positional-arguments

auth:
    aws sts get-caller-identity

check:
    shellcheck scripts/*.sh
    terraform -chdir=infra fmt -check
    terraform -chdir=infra validate

init:
    terraform -chdir=infra init

plan:
    terraform -chdir=infra plan

apply:
    terraform -chdir=infra apply

key-init:
    python3 scripts/cache.py key-init

credentials:
    python3 scripts/cache.py credentials

build package="obs-backgroundremoval":
    python3 scripts/cache.py build "$1"

status id:
    python3 scripts/cache.py status "$1"

logs id:
    python3 scripts/cache.py logs "$1"

stop id:
    aws codebuild stop-build --id "$1"

fetch id:
    python3 scripts/cache.py fetch "$1"
